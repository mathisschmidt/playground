# Research Hub configuration.
# Copy to ".env" (docker compose loads it automatically) or paste these into
# Portainer's stack "Environment variables" section.

# ---- Application ----
# Title shown in the UI / API.
RESEARCH_HUB_TITLE=Research Hub
# Allowed CORS origins, comma-separated. "*" allows all (fine when the UI and
# API are served from the same origin, which is the default production setup).
RESEARCH_HUB_CORS_ORIGINS=*

# ---- Production stack (docker-compose.yml) ----
# Host port the hub is published on -> http://localhost:<HUB_PORT>
HUB_PORT=8000
# Host folder mounted as the dataset directory. Drop .csv files here; no rebuild.
HUB_DATA_PATH=./data
# Image tag, container name and restart policy.
HUB_IMAGE=research-hub:latest
HUB_CONTAINER_NAME=research-hub
HUB_RESTART=unless-stopped

# ---- Dev stack (docker-compose.dev.yml) ----
# Vite UI port (with hot reload) -> http://localhost:<HUB_WEB_PORT>
HUB_WEB_PORT=5173
# Backend API port in dev.
HUB_API_PORT=8000
